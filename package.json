{
  "name": "@kud/jira-ink",
  "version": "0.3.0",
  "description": "Ink components for viewing Jira issues: the board and the issue detail screen, shared by jira-cli's TUI and cockpit",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "ink": ">=7",
    "react": ">=19"
  },
  "dependencies": {
    "@kud/ink-markdown": "0.3.0",
    "@kud/ink-ui": "0.25.0",
    "@kud/jira": "0.4.0"
  },
  "devDependencies": {
    "@kud/cli-testing": "0.1.0",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "ink": "7.1.1",
    "ink-testing-library": "4.0.0",
    "react": "19.2.8",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "keywords": [
    "jira",
    "ink",
    "react",
    "terminal",
    "tui",
    "components",
    "kud"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kud/jira-ink"
  }
}
